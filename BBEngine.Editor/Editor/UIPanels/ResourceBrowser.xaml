<UserControl x:Class="BBEngine.Editor.Editor.UIPanels.ResourceBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BBEngine.Editor.Editor.UIPanels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="197*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="131*"/>
        </Grid.ColumnDefinitions>

        <!-- Resources layer list -->
        <Border Background="Gray" Grid.RowSpan="2" Margin="2" CornerRadius="5">
            <TreeView x:Name="ResourcesDirectoryTreeview" Background="DarkGray" Margin="10">
                
            </TreeView>
        </Border>

        <!-- Directory displayer -->
        <Border Background="Gray" Grid.Column="1" Margin="2" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10" x:Name="DirectoryLayerButtonsContainer"/>
        </Border>

        <!-- File grid view -->
        <Border Background="Gray" Grid.Column="1" Grid.Row="1" Margin="2" CornerRadius="5">
            <WrapPanel x:Name="FileGridViewerPanel"/>
        </Border>
    </Grid>
</UserControl>
