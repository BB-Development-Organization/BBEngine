<Window x:Class="BBEngine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BBEngine.Editor"
        mc:Ignorable="d"
        Title="BB Engine - Welcome" Height="720" Width="1280" Background="#FF313131">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="New Project" Width="620" Height="60" FontSize="22" Margin="5" Click="New_Click"/>
            <Button Content="Open Project" Width="620" Height="60" FontSize="22" Margin="5" Click="Open_Click"/>
            <Button Content="Exit Engine" Width="620" Height="60" FontSize="22" Margin="5" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
